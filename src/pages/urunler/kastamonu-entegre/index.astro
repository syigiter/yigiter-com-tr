---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CatalogCenter from '../../../components/kastamonu-entegre/CatalogCenter.astro';
import SurfaceGallery from '../../../components/kastamonu-entegre/SurfaceGallery.astro';
import { buildCollectionPage } from '../../../lib/schema';
import {
  decorativeSurfaceSamples,
  doorpanSurfaceSamples,
  localCatalogs,
  productFamilies,
  productFamiliesById,
  productImagesById,
} from '../../../data/kastamonu-entegre';

function getProduct(id: string) {
  const product = productFamiliesById.get(id);
  if (!product) throw new Error(`Kastamonu ürün ailesi bulunamadı: ${id}`);
  return product;
}

function getImage(id: string) {
  const image = productImagesById.get(id);
  if (!image) throw new Error(`Kastamonu ürün görseli bulunamadı: ${id}`);
  return image;
}

const heroImage = getImage('ke-img-001');
const surfaceCount = decorativeSurfaceSamples.length + doorpanSurfaceSamples.length;
const surfaceSamples = [...decorativeSurfaceSamples, ...doorpanSurfaceSamples];
const title = 'Kastamonu Entegre Ürünleri';
const description =
  "Kastamonu Entegre Ana Bayisi Yiğiter'den MDF, yonga levha, dekoratif panel, Doorpan ve Doorlam ürünlerini inceleyin; stok, ölçü ve termin için teklif alın.";

const hubGroups = [
  {
    title: 'MDF',
    eyebrow: 'Ham Panel',
    description: getProduct('raw-mdf').summary,
    productIds: ['raw-mdf'],
    href: '/urunler/kastamonu-entegre/mdf/',
    image: getImage('ke-img-003'),
  },
  {
    title: 'Yonga Levha',
    eyebrow: 'Ham ve Melamin Kaplı',
    description: getProduct('raw-particleboard').summary,
    productIds: ['raw-particleboard', 'teknolam-yongalam'],
    href: '/urunler/kastamonu-entegre/yongalevha/',
    image: getImage('ke-img-002'),
  },
  {
    title: 'Melamin Kaplı MDF',
    eyebrow: 'Medelam',
    description: getProduct('medelam').summary,
    productIds: ['medelam'],
    href: '/urunler/kastamonu-entegre/mdflam/',
    image: heroImage,
  },
  {
    title: 'Dekoratif Panel',
    eyebrow: 'Parlak, Mat, Akrilik ve Compact',
    description:
      'Melamin kaplı, parlak, mat, akrilik, boyalı ve compact panel ailelerini tek sayfada inceleyin.',
    productIds: [
      'medelam',
      'teknolam-yongalam',
      'glossmax',
      'glossmax-pro',
      'mattplus',
      'evogloss',
      'acrylic-panel',
      'industrial-acrylic-panel',
      'printpan',
      'compact-panel-lam',
    ],
    href: '/urunler/kastamonu-entegre/dekoratif-panel/',
    image: getImage('ke-img-004'),
  },
  {
    title: 'Kapı Paneli',
    eyebrow: 'Doorpan ve Doorlam',
    description:
      'Doorpan beyaz astarlı kapı panelleri ile Doorlam dekoratif hazır panellerini karşılaştırın.',
    productIds: ['doorpan', 'doorlam'],
    href: '/urunler/kastamonu-entegre/kapi-paneli/',
    image: getImage('ke-img-005'),
  },
].map((group) => ({
  ...group,
  productNames: group.productIds.map((id) => getProduct(id).displayName),
}));
const collectionSchema = buildCollectionPage({
  name: title,
  description,
  url: '/urunler/kastamonu-entegre/',
  items: hubGroups.map((group) => ({
    name: `Kastamonu Entegre ${group.title}`,
    description: group.description,
    url: group.href,
    image: group.image.src,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage.src}
  structuredData={collectionSchema}
>
  <nav aria-label="Sayfa yolu" class="border-b border-gray-200 bg-gray-50 py-3">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-600">
        <li><a href="/" class="hover:text-primary">Ana Sayfa</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li><a href="/urunler/" class="hover:text-primary">Ürünler</a></li>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li aria-current="page" class="font-medium text-gray-900">Kastamonu Entegre</li>
      </ol>
    </div>
  </nav>

  <section class="overflow-hidden border-b border-primary-800 bg-primary-900 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-20">
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-accent-400">
          Kastamonu Entegre Ana Bayisi
        </p>
        <h1 class="max-w-3xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
          Panel ürünlerini doğru aileden seçin
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
          Ham MDF ve yonga levhadan melamin kaplı, parlak, mat, akrilik ve kapı paneli
          çözümlerine kadar resmî ürün ailelerini tek merkezden inceleyin.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-white/65">
          Üretici ürün gamı ile Yiğiter'in güncel stok ve tedarik durumu ayrı değerlendirilir.
          Ölçü, dekor ve termin bilgisi teklif aşamasında netleştirilir.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="#urun-aileleri"
            class="inline-flex items-center justify-center rounded-lg bg-[#9A3412] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[#7C2D12]"
          >
            Ürün Ailelerini İncele
          </a>
          <a
            href="/teklif-al?urun=Kastamonu%20Entegre%20Panel%20%C3%9Cr%C3%BCnleri"
            data-analytics-event="Quote Click"
            data-analytics-product="Kastamonu Entegre Panel Ürünleri"
            data-analytics-placement="hero"
            class="inline-flex items-center justify-center rounded-lg border border-white/40 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-primary"
          >
            Teklif Al
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-2xl border border-white/15 bg-white/5 p-3 shadow-2xl">
          <img
            src={heroImage.src}
            width={heroImage.width}
            height={heroImage.height}
            alt={heroImage.alt}
            decoding="async"
            class="aspect-[16/10] w-full rounded-xl object-cover"
          />
        </div>
        <div class="mt-3 grid grid-cols-3 gap-3" aria-label="Seçili yüzey örnekleri">
          {decorativeSurfaceSamples.slice(10, 13).map((sample) => (
            <img
              src={sample.src}
              width={sample.width}
              height={sample.height}
              alt={sample.alt}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full rounded-xl border border-white/15 object-cover"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Program özeti" class="border-b border-gray-200 bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-gray-200 sm:grid-cols-4">
      {[
        ['Ana Bayi', 'Yiğiter statüsü'],
        [String(productFamilies.length), 'Doğrulanmış ürün ailesi'],
        [String(surfaceCount), 'Yüzey/doku örneği'],
        [String(localCatalogs.length), 'Yerel resmî katalog'],
      ].map(([value, label]) => (
        <div class="bg-white px-4 py-6 text-center">
          <p class="text-2xl font-bold text-primary">{value}</p>
          <p class="mt-1 text-xs text-gray-600">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <nav aria-label="Kastamonu Entegre sayfa bölümleri" class="border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap gap-2 px-4 py-4 sm:px-6 lg:px-8">
      {[
        ['Ürün Aileleri', '#urun-aileleri'],
        ['Katalog Merkezi', '#kataloglar'],
        ['Yüzey Galerisi', '#yuzeyler'],
        ['Teklif', '#teklif'],
      ].map(([label, href]) => (
        <a
          href={href}
          class="rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-primary hover:border-primary/30 hover:bg-white"
        >
          {label}
        </a>
      ))}
    </div>
  </nav>

  <section id="urun-aileleri" class="scroll-mt-24 py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-widest text-accent-dark">Ürün Merkezi</p>
        <h2 class="mt-3 text-3xl font-bold text-primary lg:text-4xl">Kastamonu Entegre ürün grupları</h2>
        <p class="mt-4 leading-7 text-gray-700">
          Teknik ürün bilgisini resmî kaynaklardan, stok ve teslimat bilgisini ise güncel teklif
          sürecinden alırsınız. İhtiyacınıza uygun gruptan başlayın.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {hubGroups.map((group) => (
          <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
            <img
              src={group.image.src}
              width={group.image.width}
              height={group.image.height}
              alt={group.image.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full bg-gray-100 object-cover"
            />
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-bold uppercase tracking-widest text-accent-dark">{group.eyebrow}</p>
              <h3 class="mt-2 text-2xl font-bold text-primary">{group.title}</h3>
              <p class="mt-3 text-sm leading-6 text-gray-700">{group.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${group.title} ürün aileleri`}>
                {group.productNames.map((name) => (
                  <li class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs text-gray-700">
                    {name}
                  </li>
                ))}
              </ul>
              <a
                href={group.href}
                class="mt-auto pt-6 text-sm font-bold text-primary underline decoration-accent/50 underline-offset-4 hover:text-accent-dark"
              >
                {group.title} ürünlerini incele →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CatalogCenter catalogs={localCatalogs} />

  <SurfaceGallery samples={surfaceSamples} />

  <section class="bg-wood-100 py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-accent-dark">Teklif Süreci</p>
          <h2 class="mt-3 text-3xl font-bold text-primary">İhtiyacınızı birlikte netleştirelim</h2>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {[
              ['1', 'Ürün ailesini seçin'],
              ['2', 'Ölçü, dekor veya yüzey kodunu paylaşın'],
              ['3', 'Miktar ve teslimat şehrini belirtin'],
              ['4', 'Stok ve termin teyitli teklif alın'],
            ].map(([step, label]) => (
              <li class="flex items-center gap-3 rounded-xl border border-wood-300 bg-white/70 p-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
                  {step}
                </span>
                <span class="text-sm font-medium text-gray-800">{label}</span>
              </li>
            ))}
          </ol>
        </div>
        <div id="teklif" class="scroll-mt-24 rounded-2xl bg-primary p-6 text-white shadow-lg sm:p-8">
          <h2 class="text-2xl font-bold">Kastamonu Entegre teklifi alın</h2>
          <p class="mt-3 text-sm leading-6 text-white/75">
            Ürün, ölçü, adet ve teslimat şehrini paylaşın; güncel tedarik durumuna göre dönüş yapalım.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <a
              href="/teklif-al?urun=Kastamonu%20Entegre%20Panel%20%C3%9Cr%C3%BCnleri"
              data-analytics-event="Quote Click"
              data-analytics-product="Kastamonu Entegre Panel Ürünleri"
              data-analytics-placement="final-cta"
              class="inline-flex items-center justify-center rounded-lg bg-[#9A3412] px-5 py-3 text-sm font-bold text-white hover:bg-[#7C2D12]"
            >
              Teklif Formunu Aç
            </a>
            <a
              href="https://wa.me/905464886737?text=Merhaba%2C%20Kastamonu%20Entegre%20panel%20%C3%BCr%C3%BCnleri%20i%C3%A7in%20bilgi%20almak%20istiyorum."
              data-analytics-event="WhatsApp Click"
              data-analytics-product="Kastamonu Entegre Panel Ürünleri"
              data-analytics-placement="final-cta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg border border-white/35 px-5 py-3 text-sm font-semibold text-white hover:bg-white hover:text-primary"
            >
              WhatsApp ile Sor
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

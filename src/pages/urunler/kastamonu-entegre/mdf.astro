---
import PanelFamilyPage from '../../../components/kastamonu-entegre/PanelFamilyPage.astro';
import {
  productFamiliesById,
  productImagesById,
} from '../../../data/kastamonu-entegre';

const product = productFamiliesById.get('raw-mdf');
const heroImage = productImagesById.get('ke-img-003');

if (!product || !heroImage) {
  throw new Error('Kastamonu Entegre MDF sayfası verisi bulunamadı.');
}
---

<PanelFamilyPage
  title="Kastamonu Entegre Ham MDF"
  description="Kastamonu Entegre ham MDF ürün ailesini, kullanım alanlarını ve teklif için gerekli bilgileri inceleyin. Stok, ölçü ve termin güncel teklifte teyit edilir."
  pageLabel="MDF"
  heading="Kastamonu Entegre Ham MDF"
  lead="Mobilya, iç mekân ve işlenmiş panel uygulamalarında pürüzsüz bir çalışma zemini sunan ham MDF ürün ailesi."
  product={product}
  heroImage={heroImage}
  imageFit="contain"
  overview={[
    'Ham MDF, ahşap liflerinin panel yapısında bir araya getirilmesiyle elde edilen, homojen ve pürüzsüz yüzeyli bir levhadır. Freze, CNC, boyama, folyo ve dekoratif kaplama gibi işlemler için bir taşıyıcı zemin sunar.',
    'Kastamonu Entegre ürün gamında kullanım ve işleme amacına göre farklı MDF tipleri bulunur. Yiğiter stok kapsamı, ölçü ve ürün tipi talebiniz doğrultusunda ayrıca teyit edilir.',
  ]}
  comparisonTitle="MDF tipini işleme amacına göre belirleyin"
  comparisonDescription="Freze derinliği, uygulanacak yüzey işlemi ve proje ölçüsü ürün seçimini etkiler. Teyitsiz tek bir kalınlık veya stok listesi yayınlamak yerine ihtiyacı teklif aşamasında eşleştiriyoruz."
  comparedProducts={[product]}
  selectionPoints={[
    {
      title: 'İşleme biçimi',
      description: 'CNC, freze, profil açma, kesim veya düz gövde kullanımını belirtin.',
    },
    {
      title: 'Yüzey işlemi',
      description: 'Lake boya, folyo, melamin veya başka bir kaplama uygulanacaksa paylaşın.',
    },
    {
      title: 'Ölçü ve miktar',
      description: 'İstenen kalınlık, levha ölçüsü, adet/palet ve teslimat şehrini yazın.',
    },
  ]}
  quoteProduct="Kastamonu Entegre MDF"
  catalogTitle="Güncel MDF ürün bilgisini talebinize göre paylaşalım"
  catalogDescription="Resmî ürün gamı zaman içinde güncellenebilir. İhtiyacınıza uygun ürün tipi, güncel doküman ve numune bilgisi satış ekibi tarafından teyit edilerek paylaşılır."
  relatedLinks={[
    { label: 'Medelam / MDFLam', href: '/urunler/kastamonu-entegre/mdflam/' },
    { label: 'Yonga Levha', href: '/urunler/kastamonu-entegre/yongalevha/' },
    { label: 'Çok markalı MDF', href: '/urunler/mdf/' },
    { label: 'Kastamonu Entegre ürün merkezi', href: '/urunler/kastamonu-entegre/' },
  ]}
/>

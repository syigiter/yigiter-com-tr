---
import PanelFamilyPage from '../../../components/kastamonu-entegre/PanelFamilyPage.astro';
import {
  decorativeSurfaceSamples,
  productFamiliesById,
  productImagesById,
} from '../../../data/kastamonu-entegre';

const product = productFamiliesById.get('raw-particleboard');
const melamineProduct = productFamiliesById.get('teknolam-yongalam');
const heroImage = productImagesById.get('ke-img-002');

if (!product || !melamineProduct || !heroImage) {
  throw new Error('Kastamonu Entegre yonga levha sayfası verisi bulunamadı.');
}

const featuredSurfaces = [
  decorativeSurfaceSamples[0],
  decorativeSurfaceSamples[2],
  decorativeSurfaceSamples[5],
  decorativeSurfaceSamples[7],
  decorativeSurfaceSamples[10],
  decorativeSurfaceSamples[15],
];
---

<PanelFamilyPage
  title="Kastamonu Entegre Yonga Levha"
  description="Kastamonu Entegre ham yonga levha ile melamin kaplı Teknolam/Yongalam ürün ailelerini karşılaştırın. Güncel stok, ölçü, dekor ve termin için teklif alın."
  pageLabel="Yonga Levha"
  heading="Ham Yonga Levha ve Teknolam"
  lead="Mobilya ve iç mekân üretiminde kullanılan ham yonga levha ile melamin kaplı Teknolam/Yongalam ürün ailelerini doğru bağlamda karşılaştırın."
  product={product}
  heroImage={heroImage}
  imageFit="contain"
  overview={[
    'Ham yonga levha, odun yongalarının reçineyle sıcaklık ve basınç altında preslenmesiyle üretilen temel paneldir. Mobilya gövdesi ve dekoratif kaplama uygulamalarında taşıyıcı levha olarak değerlendirilir.',
    'Teknolam/Yongalam ise yonga levha üzerine melamin uygulanarak elde edilen hazır dekoratif panel ailesidir. Ham ve melamin kaplı ürünlerin dekor, yüzey ve kullanım beklentileri farklıdır.',
  ]}
  comparisonTitle="Ham levha ile melamin kaplı paneli ayırın"
  comparisonDescription="Teklif talebinde yalnızca “sunta” yazmak yerine ham levha mı, yoksa dekoratif yüzeyli Teknolam/Yongalam mı istediğinizi belirtmek ürün eşleştirmesini hızlandırır."
  comparedProducts={[product, melamineProduct]}
  selectionPoints={[
    {
      title: 'Ürün tipi',
      description: 'Ham yonga levha veya melamin kaplı Teknolam/Yongalam tercihini belirtin.',
    },
    {
      title: 'Dekor ve kullanım',
      description: 'Kaplı üründe dekor/yüzey kodunu; ham üründe uygulanacak kaplama işlemini paylaşın.',
    },
    {
      title: 'Ölçü ve miktar',
      description: 'Kalınlık, levha ölçüsü, adet/palet ve teslimat şehrini teklif talebine ekleyin.',
    },
  ]}
  surfaceSamples={featuredSurfaces}
  surfaceHeading="Teknolam/Yongalam için yüzey dokusu örnekleri"
  quoteProduct="Kastamonu Entegre Yongalevha Teknolam"
  catalogTitle="Ham ve melamin kaplı ürün bilgisini güncel kaynaktan alın"
  catalogDescription="Ürün tipi, dekor, ölçü ve tedarik durumu değişebilir. Güncel katalog ve numune talebinizi kullanım amacınızla birlikte iletin."
  relatedLinks={[
    { label: 'Ham MDF', href: '/urunler/kastamonu-entegre/mdf/' },
    { label: 'Medelam / MDFLam', href: '/urunler/kastamonu-entegre/mdflam/' },
    { label: 'Dekoratif Panel', href: '/urunler/kastamonu-entegre/dekoratif-panel/' },
    { label: 'Çok markalı yonga levha', href: '/urunler/yongalevha/' },
  ]}
/>

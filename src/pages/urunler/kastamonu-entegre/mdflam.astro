---
import PanelFamilyPage from '../../../components/kastamonu-entegre/PanelFamilyPage.astro';
import {
  decorativeSurfaceSamples,
  productFamiliesById,
  productImagesById,
} from '../../../data/kastamonu-entegre';

const product = productFamiliesById.get('medelam');
const heroImage = productImagesById.get('ke-img-008');

if (!product || !heroImage) {
  throw new Error('Kastamonu Entegre MDFLam sayfası verisi bulunamadı.');
}

const featuredSurfaces = [
  decorativeSurfaceSamples[0],
  decorativeSurfaceSamples[1],
  decorativeSurfaceSamples[6],
  decorativeSurfaceSamples[8],
  decorativeSurfaceSamples[11],
  decorativeSurfaceSamples[14],
];
---

<PanelFamilyPage
  title="Kastamonu Entegre Medelam MDFLam"
  description="Kastamonu Entegre Medelam melamin kaplı MDF ürün ailesini, yüzey örneklerini ve kullanım alanlarını inceleyin. Güncel dekor, ölçü ve stok için teklif alın."
  pageLabel="MDFLam"
  heading="Medelam — Melamin Kaplı MDF"
  lead="MDF levha üzerine melamin uygulanarak elde edilen, mobilya ve iç dekorasyona yönelik hazır dekoratif panel."
  product={product}
  heroImage={heroImage}
  overview={[
    'Sektörde MDFLam olarak anılan ürünün Kastamonu Entegre ürün ailesindeki karşılığı Medelam’dır. Taşıyıcı MDF levhanın yüzeyi melaminle kaplanır; bu nedenle “laminat kaplı MDF” yerine doğru ifade “melamin kaplı MDF”dir.',
    'Dekor ve doku seçimi görsel beklentiye göre yapılırken levha ölçüsü, kalınlık ve güncel tedarik durumu proje bazında teyit edilir. Yüzey örnekleri renk kartelası değil, dokunun karakterini gösterir.',
  ]}
  comparisonTitle="Hazır dekoratif yüzeyi doğru adla seçin"
  comparisonDescription="Medelam, ham MDF’den farklı olarak melamin kaplı hazır bir yüzey sunar. Parlak, ekstra mat veya akrilik gibi farklı teknoloji aileleri ise dekoratif panel sayfasında ayrı ürünler olarak değerlendirilir."
  comparedProducts={[product]}
  selectionPoints={[
    {
      title: 'Dekor ve doku',
      description: 'Dekor adı/kodu ile istenen yüzey dokusunu veya fiziksel numuneyi belirtin.',
    },
    {
      title: 'Uygulama alanı',
      description: 'Gövde, kapak, raf, duvar paneli veya sabit mobilya kullanımını paylaşın.',
    },
    {
      title: 'Ölçü ve miktar',
      description: 'Kalınlık, levha ölçüsü, adet/palet ve teslimat şehriyle teklif isteyin.',
    },
  ]}
  surfaceSamples={featuredSurfaces}
  surfaceHeading="Medelam seçiminde kullanılabilecek yüzey dokuları"
  quoteProduct="Kastamonu Entegre MDFLam Medelam"
  catalogTitle="Güncel dekor ve yüzey bilgisini birlikte teyit edin"
  catalogDescription="Ekran rengi nihai seçim için yeterli değildir. Güncel katalog, dekor durumu ve fiziksel numune talebinizi satış ekibine iletin."
  relatedLinks={[
    { label: 'Ham MDF', href: '/urunler/kastamonu-entegre/mdf/' },
    { label: 'Dekoratif Panel', href: '/urunler/kastamonu-entegre/dekoratif-panel/' },
    { label: 'Çok markalı MDFLam', href: '/urunler/mdflam/' },
    { label: 'Kastamonu Entegre ürün merkezi', href: '/urunler/kastamonu-entegre/' },
  ]}
/>

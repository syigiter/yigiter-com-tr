---
import type { CatalogDocument } from '../../data/kastamonu-entegre';

interface Props {
  catalog: CatalogDocument & { localPath: string };
  compact?: boolean;
}

const { catalog, compact = false } = Astro.props;
const sizeLabel = catalog.fileBytes
  ? `${(catalog.fileBytes / 1_000_000).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} MB`
  : undefined;
const versionLabel = catalog.version.startsWith('v')
  ? catalog.version
  : `v${catalog.version}`;
---

<a
  href={catalog.localPath}
  download={catalog.fileName}
  class:list={[
    'group inline-flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white text-primary transition-colors hover:border-primary/30 hover:bg-gray-50',
    compact ? 'px-4 py-3 text-sm' : 'w-full px-5 py-4',
  ]}
>
  <span class="min-w-0">
    <span class="block font-semibold">{catalog.title}</span>
    <span class="mt-0.5 block text-xs font-normal text-gray-500">
      Resmî katalog
      {catalog.year && ` · ${catalog.year}`}
      {` · Sürüm ${versionLabel}`}
      {sizeLabel && ` · ${sizeLabel}`}
    </span>
  </span>
  <span class="shrink-0 text-xl leading-none text-accent transition-transform group-hover:translate-y-0.5" aria-hidden="true">
    ↓
  </span>
</a>

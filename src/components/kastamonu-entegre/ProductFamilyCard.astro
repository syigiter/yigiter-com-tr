---
import type {
  CatalogDocument,
  KastamonuProductFamily,
  ProductImage,
} from '../../data/kastamonu-entegre';
import CatalogDownload from './CatalogDownload.astro';

interface Props {
  product: KastamonuProductFamily;
  image?: ProductImage;
  catalogs?: CatalogDocument[];
  headingLevel?: 'h2' | 'h3';
  quoteHref?: string;
  showDetailLink?: boolean;
}

const {
  product,
  image,
  catalogs = [],
  headingLevel = 'h3',
  quoteHref,
  showDetailLink = true,
} = Astro.props;
const Heading = headingLevel;
const categoryLabels: Record<KastamonuProductFamily['category'], string> = {
  'raw-panel': 'Ham Panel',
  'melamine-panel': 'Melamin Kaplı Panel',
  'gloss-panel': 'Parlak Yüzey',
  'mat-panel': 'Mat Yüzey',
  'acrylic-panel': 'Akrilik Panel',
  'printed-panel': 'Boyalı Panel',
  'compact-panel': 'Compact Panel',
  'door-panel': 'Kapı Paneli',
};
const localCatalogs = catalogs.filter(
  (catalog): catalog is CatalogDocument & { localPath: string } =>
    catalog.publicationStatus === 'local' && Boolean(catalog.localPath),
);
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white">
  {
    image && (
      <div class="aspect-[16/9] overflow-hidden bg-gray-100">
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="mb-2 text-xs font-bold uppercase tracking-widest text-accent-dark">
      {categoryLabels[product.category]}
    </p>
    <Heading class="text-xl font-bold text-primary">{product.displayName}</Heading>
    <p class="mt-3 text-sm leading-6 text-gray-600">{product.summary}</p>

    <ul class="mt-5 space-y-2">
      {
        product.highlights.slice(0, 3).map((highlight) => (
          <li class="flex items-start gap-2 text-sm text-gray-700">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{highlight}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-5 rounded-lg bg-gray-50 px-3 py-2 text-xs text-gray-600">
      {product.availability.label}
    </p>

    <div class="mt-auto space-y-3 pt-5">
      {
        localCatalogs.map((catalog) => (
          <CatalogDownload catalog={catalog} compact />
        ))
      }
      <div class="flex flex-col gap-2 sm:flex-row">
        {
          quoteHref && (
            <a
              href={quoteHref}
              class="inline-flex flex-1 items-center justify-center rounded-lg bg-[#9A3412] px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-[#7C2D12]"
            >
              Teklif Al
            </a>
          )
        }
        {
          showDetailLink && (
            <a
              href={product.route}
              class="inline-flex flex-1 items-center justify-center rounded-lg border border-primary px-4 py-3 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
            >
              Ürünü İncele
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

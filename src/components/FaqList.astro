---
// SSS listesi + FAQPage JSON-LD. Sayfa başına bir kez kullanın (tek FAQPage).
interface Props {
  items: { question: string; answer: string; links?: { label: string; href: string }[] }[];
  title?: string;
}
const { items, title = 'Sık sorulan sorular' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<h2 class="text-2xl sm:text-3xl font-bold text-primary mb-6">{title}</h2>
<dl class="space-y-4 max-w-3xl">
  {items.map((item) => (
    <div class="border-b border-gray-200 pb-4">
      <dt class="font-bold text-gray-900 mb-2">{item.question}</dt>
      <dd class="text-gray-700 leading-relaxed">
        {item.answer}
        {item.links && (
          <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
            {item.links.map((link) => (
              <a href={link.href} class="font-semibold text-accent-dark underline underline-offset-2" {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}</a>
            ))}
          </span>
        )}
      </dd>
    </div>
  ))}
</dl>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

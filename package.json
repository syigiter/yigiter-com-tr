{
  "name": "yigiter-com-tr",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "assets:kastamonu:sync": "node scripts/sync-kastamonu-assets.mjs --sync",
    "assets:kastamonu:verify": "node scripts/sync-kastamonu-assets.mjs --verify",
    "data:kastamonu:verify": "node --experimental-strip-types scripts/validate-kastamonu-data.mjs",
    "types:kastamonu:check": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext src/data/kastamonu-entegre.ts",
    "qa:kastamonu:production": "node scripts/validate-production-kastamonu.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
